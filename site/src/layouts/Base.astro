---
import '@fontsource-variable/inter'
import '../styles/global.css'
import og from '../../../assets/social-preview.png'
import ogVi from '../../../assets/social-preview-vi.png'
import ogZh from '../../../assets/social-preview-zh.png'
import { dicts, locales, type Locale } from '../i18n'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = dicts[locale]
const site = Astro.site ?? new URL('https://davish.dangth.dev')
const here = locales.find((l) => l.id === locale)!
const image = new URL({ en: og, vi: ogVi, zh: ogZh }[locale].src, site).href
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(here.path, site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={new URL(l.path, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={new URL(here.path, site).href} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
