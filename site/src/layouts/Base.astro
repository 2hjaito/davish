---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource/be-vietnam-pro/700.css'
import '@fontsource-variable/geist-mono'
import '../styles/global.css'
import og from '../../../assets/social-preview.png'
import ogVi from '../../../assets/social-preview-vi.png'
import ogZh from '../../../assets/social-preview-zh.png'
import { dicts, locales, type Locale } from '../i18n'

interface Props {
  locale: Locale
  /** The page's own path under the locale (empty for the landing page). */
  suffix?: string
  title?: string
  description?: string
}
const { locale, suffix = '', title, description } = Astro.props
const t = dicts[locale]
const pageTitle = title ?? t.title
const pageDescription = description ?? t.description
const site = Astro.site ?? new URL('https://davish.app')
const here = locales.find((l) => l.id === locale)!
const image = new URL({ en: og, vi: ogVi, zh: ogZh }[locale].src, site).href
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Before paint: JavaScript is on, and the theme the visitor chose
      // (shared with the docs) or the system's.
      ;(() => {
        const r = document.documentElement
        r.classList.add('js')
        let saved = ''
        try {
          saved = localStorage.getItem('starlight-theme') || ''
        } catch {}
        const dark = matchMedia('(prefers-color-scheme: dark)')
        const apply = () =>
          (r.dataset.theme = saved === 'light' || saved === 'dark' ? saved : dark.matches ? 'dark' : 'light')
        apply()
        dark.addEventListener('change', apply)
        window.__setTheme = (t) => {
          saved = t
          try {
            localStorage.setItem('starlight-theme', t)
          } catch {}
          apply()
        }
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(here.path + suffix, site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={new URL(l.path + suffix, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/' + suffix, site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={new URL(here.path + suffix, site).href} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
