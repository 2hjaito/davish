---
// A Tabler icon (MIT), read from the package at build time and inlined,
// so the page loads no icon font or sprite.
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  name: string
  size?: number
  stroke?: number
}
const { name, size = 18, stroke = 1.75 } = Astro.props
const file = join(process.cwd(), 'node_modules', '@tabler', 'icons', 'icons', 'outline', `${name}.svg`)
const inner = readFileSync(file, 'utf8')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/<path stroke="none" d="M0 0h24v24H0z" fill="none"\s*\/>/, '')
---

<svg
  class="icon"
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
