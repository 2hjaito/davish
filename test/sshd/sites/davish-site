# Test site for the Nginx app: enabled at build, serves one page on 8081.
upstream davish_backend {
    server 127.0.0.1:9000;
}

server {
    listen 8081;
    listen [::]:8081;
    server_name davish.test www.davish.test;

    root /srv/davish-site;
    index index.html;

    location /api/ {
        proxy_pass http://davish_backend;
    }
}
